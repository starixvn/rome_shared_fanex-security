        private bool Closing()
        {
            if (_closed && CheckTime.AddMinutes(-ClosedDuration) <= LastClosed)
            {
                PageStatus = Status.Closing;
                return true;
            }
            if (OverLimitedDuration() && OverBlockHit())
            {
                _closed = true;
                LastClosed = (LastClosed < FirstHitTime) ? CheckTime : LastClosed;
                PageStatus = Status.Closing;
                return true;
            }
            _closed = false;
            return false;
        }

