        private void ResetLimitedHit()
        {
            CurrentHit = 1;
            PageStatus = Status.Opening;
        }

        private void ResetBlockedHit()
        {
            ResetLimitedHit();
            FirstHitTime = CheckTime;
            HitRecords = new List<HitRecord>
                {
                    new HitRecord
                        {
                            Hit = CurrentHit,
                            RecordTime = FirstHitTime
                        }
                };
            TotalHit = 1;
        }

        private bool OverLimitedHit()
        {
            return CurrentHit > LimitedHit;
        }

        private bool OverLimitedDuration()
        {
            return CheckTime.AddMinutes(-LimitedDuration) < FirstHitTime;
        }

        private bool OverBlockHit()
        {
            return TotalHit > BlockedHit;
