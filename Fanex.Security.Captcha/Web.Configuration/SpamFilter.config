<?xml version="1.0"?>
<SpamFilterConfiguration
    system="Agency"
    resolver="Fanex.Security.SpamFilter.Resolver.EmptyResolver, Fanex.Security.SpamFilter"
    repository="Couchbase"
    connectionString="http://10.18.200.209:8091/pools/;Bucket=Fanex.Security.SpamFilter;BucketPassword=">

  <rules>

    <!--Max "threshold" request(s) in "timeSpan" minute(s) by "filter" (IP, SessionId or a custom value) -->
    <add name="Login"
         path="/Account/JsonLogin"
         method="GET,POST"
         minutes="1"
         threshold="3"
         autoIncrement="false"
         includeRejectedRequest="true"
         filter="Fanex.Security.SpamFilter.Filter.IPFilter, Fanex.Security.SpamFilter"
         resolver="Fanex.Security.SpamFilter.Resolver.JsonResolver, Fanex.Security.SpamFilter.Test">
    </add>

    <!--
          When autoIncrement=true, counter auto increment when http request was hit.
          When autoIncrement=false, user must explicit increment the counter by 
          calling System.Web.HttpContext.Current.SpamFilterIncrement(delta)
      -->

    <add path="/_MemberInfo/PositionTaking/Agent/AddNewMember.aspx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewMember.ashx;
         /_MemberInfo/PositionTaking/Master/AddNewAgent.aspx;
         /_MemberInfo/PositionTaking/Super/AddNewMaster.aspx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewAgent.ashx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewMaster.ashx;
         /_MemberInfo/SearchAndCopy/Agent/InfoMember.aspx;
         /_MemberInfo/SearchAndCopy/Master/InfoAgent.aspx;
         /_MemberInfo/SearchAndCopy/Super/MasterInfo.aspx;
         /_MemberInfo/SearchAndCopy/Handlers/Agent/CopyMember.ashx;
         /_MemberInfo/SearchAndCopy/Handlers/Master/CopyAgent.ashx;
         /_MemberInfo/SearchAndCopy/Handlers/Super/CopyMaster.ashx;
         /SpamFilter/Captcha/CheckCaptcha"
         method="*"
         minutes="5"
         autoIncrement="false"
         threshold="3"
         filter="Fanex.Razorbill.Security.SpamFilter.UserFilter, Fanex.Razorbill.Security"
         name="CreateAccount.Captcha">
    </add>

    <add path="/_MemberInfo/PositionTaking/Agent/AddNewMember.aspx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewMember.ashx;
         /_MemberInfo/PositionTaking/Master/AddNewAgent.aspx;
         /_MemberInfo/PositionTaking/Super/AddNewMaster.aspx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewAgent.ashx;
         /_MemberInfo/PositionTaking/Handlers/SaveNewMaster.ashx;
         /_MemberInfo/SearchAndCopy/Agent/InfoMember.aspx;
         /_MemberInfo/SearchAndCopy/Master/InfoAgent.aspx;
         /_MemberInfo/SearchAndCopy/Super/MasterInfo.aspx;
         /_MemberInfo/SearchAndCopy/Handlers/Agent/CopyMember.ashx;
         /_MemberInfo/SearchAndCopy/Handlers/Master/CopyAgent.ashx;
         /_MemberInfo/SearchAndCopy/Handlers/Super/CopyMaster.ashx;
         /SpamFilter/BlockPage/Index"
        method="*"
        minutes="5"
        autoIncrement="false"
        threshold="5"
        blockDuration="2"
        filter="Fanex.Razorbill.Security.SpamFilter.UserFilter, Fanex.Razorbill.Security"
        name="CreateAccount.Blocked">
    </add>

  </rules>

</SpamFilterConfiguration>