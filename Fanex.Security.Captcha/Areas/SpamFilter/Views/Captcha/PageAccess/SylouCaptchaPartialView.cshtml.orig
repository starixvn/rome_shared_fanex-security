@model CaptchaMvc.Models.DefaultBuildInfoModel
@{
    string id = Guid.NewGuid().ToString("N");
    string functionName = string.Format("______{0}________()", Guid.NewGuid().ToString("N"));
    <script type="text/javascript">
    
        $(function () {
            $('#@id').show();
    });


    function @functionName {
            $('#@id').hide();
        $.post("@Model.RefreshUrl", { @Model.TokenParameterName: $('#@Model.TokenElementId').val() }, 
            function () {
                $('#@id').show();
            });
        return false;
    }
    </script>
}
<div id="captchaWrapper">
<div id="popup">
    <div class="ptitle">
        <div class="atticon">
        </div>
        @Security.securitycheck
    </div>
    <div class="pcon">
        <p>
            @Security.securitytitlenotification
        </p>
        @if (ViewBag.Error != null)
        {
        <div id="message-box">
            <span class="message-error">@Security.securityerrorcaptcha </span>
        </div>
        }
        <div id="recaptcha_widget">
            <table style="border-collapse: collapse" border="1px" class="recaptchatable recaptcha_theme_white"
                id="recaptcha_table">
                <tbody>
                    <tr>
                        <td class="recaptcha_r1_c1" colspan="6">
                        </td>
                    </tr>
                    <tr>
                        <td class="recaptcha_r2_c1">
                        </td>
                        <td class="recaptcha_image_cell" colspan="4">
                            <img id="@Model.ImageElementId" src="@Model.ImageUrl" style="width:300px; height: 57px" />
@Html.Hidden(Model.TokenElementId, Model.TokenValue)
                        </td>
                        <td class="recaptcha_r2_c2">
                        </td>
                    </tr>
                    <tr>
                        <td class="recaptcha_r3_c1" rowspan="6">
                        </td>
                        <td class="recaptcha_r3_c2" colspan="4">
                        </td>
                        <td class="recaptcha_r3_c3" rowspan="6">
                        </td>
                    </tr>
                    <tr>
                        <td height="49" class="recaptcha_r4_c1" rowspan="3">
                            <span class="recaptcha_response_field_label">@Security.typetheword</span>
                            @*<input type="text" id="recaptcha_response_field" 
                            name="recaptcha_response_field" />*@
                            @if (Model.IsRequired)
{
    @Html.TextBox(Model.InputElementId, null, new Dictionary<string, object>
                                                  {
                                                      {"data-val", "true"},
                                                      {"data-val-required", Model.RequiredMessage},
                                                      {"id", "recaptcha_response_field"}
                                                  })
}
else
{
    @Html.TextBox(Model.InputElementId, null, new { @id = "recaptcha_response_field" })
}
                        </td>
                        <td class="recaptcha_r4_c2" rowspan="4">
                        </td>
                        <td>
                            <a id="@id" title="Get a new challenge" href="#@Model.ImageElementId">
                                <img width="25" height="17" id="recaptcha_reload" onclick="@functionName"  src="http://www.google.com/recaptcha/api/img/white/refresh.gif"
                                    alt="Get a new challenge"></a> <a class="recaptcha_only_if_image" id="recaptcha_switch_audio_btn"
                                        title="Get an audio challenge">
                                        <img width="25" height="16" alt="Get an audio challenge" id="recaptcha_switch_audio"
                                            src="../../Areas/SpamFilter/Views/Styles/Captcha/PageAccess/Images/audio.gif"></a><a
                                                class="recaptcha_only_if_audio" id="recaptcha_switch_img_btn" title="Get a visual challenge">
                        </td>
                        <td class="recaptcha_r4_c4" rowspan="4">
                        </td>
                    </tr>
                    <tr>
                        <td>
                        </td>
                    </tr>
                    <tr>
                        <td>
                        </td>
                    </tr>
                    <tr>
                        <td class="recaptcha_r7_c1">
                        </td>
                        <td class="recaptcha_r8_c1">
                        </td>
                    </tr>
                </tbody>
            </table>
        </div>
        <div>
            <button id="SubmitCaptcha" class="pbutton" type="submit">
                @Resources.Lang.submit</button>
        </div>
    </div>
</div>
<div id='overlay' style='background-color: grey; width: 100%; height: 100%; position: fixed; left: 0; top: 0; filter: alpha(opacity = 50); zoom: 1 ; opacity: 0.5; z-index:1000;'></div>
</div>