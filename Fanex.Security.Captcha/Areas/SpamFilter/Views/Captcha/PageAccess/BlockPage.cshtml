<!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN" "http://www.w3.org/tr/xhtml1/DTD/xhtml1-transitional.dtd">
@using Resources
@model Fanex.Security.SpamFilter.Entity.IRequestBlocker
@{
    ViewBag.Title = "Recaptcha";
    //Layout = "../../Shared/_Layout.cshtml";
    
}
@functions 
{
    double TimeLeft(DateTime lastClosed, TimeSpan closedDuration)
    {
        var currentTime = DateTime.Now;

        var intTimeLeft = (closedDuration.Minutes * 60) - (int)(currentTime - lastClosed).TotalSeconds;

        TimeSpan t = TimeSpan.FromSeconds(intTimeLeft);

        return t.TotalSeconds;
    }

}
<link href="@Url.Content("~/Areas/SpamFilter/Views/Styles/Captcha/PageAccess/BlockPage.css")" rel="stylesheet" type="text/css" />
<link href="@Url.Content("~/Areas/SpamFilter/Views/Scripts/jQuery/Countdown/jquery.countdown.css?v=1")" rel="stylesheet" type="text/css" />

<div id="block">
    <div id="popup">
        <div class="ptitle">
            <div class="atticon">
            </div>
            @Security.warning
        </div>
        <div class="pcon">
            <p>
                @String.Format(Security.blockcreateuser, Model.Threshold, Model.Interval.Minutes)
                <br />
                @String.Format(Security.createuserafter, Model.Duration.Minutes)
                <br />
                @Security.timeleft
                <br />
                <div id="countdown">
                </div>
            </p>
        </div>
    </div>
    <div id='overlay' style='background-color: grey; width: 100%; height: 100%; position: fixed;
        left: 0; top: 0; filter: alpha(opacity = 50); zoom: 1; opacity: 0.5; z-index: 1000;'>
    </div>
</div>
<script src="@Url.Content("~/Areas/SpamFilter/Views/Scripts/jQuery/jquery-1.8.2.min.js")"
    type="text/javascript"></script>
<script src="@Url.Content("~/Areas/SpamFilter/Views/Scripts/jQuery/Countdown/jquery.countdown.min.js")"
    type="text/javascript"></script>
<script type="text/javascript">
    var timeLeft = @TimeLeft(Model.BlockedTime, Model.Duration);
    $(document).ready(function () {
        
       if (timeLeft > 0) {
            jQuery('#countdown').countdown({ until: timeLeft, onExpiry: RemoveBlock });
        }
        else {
            RemoveBlock();
        }
        
    });

    function RemoveBlock(){
        try {
            jQuery('#frBlockPage', window.parent.document).remove();
        } catch(e) {
            //console.log(e);
        } 
        
    }
</script>
